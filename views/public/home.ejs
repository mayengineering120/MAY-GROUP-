<%- include('../partials/header') %>
<section class="hero">
  <div class="container hero-inner">
    <p class="eyebrow"><%= [company.company_name, company.subtitle].filter(Boolean).join(' · ') %></p>
    <h1><%= company.tagline %></h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/machinery">Browse machinery</a>
      <a class="btn btn-ghost" href="/rentals">Rent machinery</a>
      <a class="btn btn-ghost" href="/projects">View our projects</a>
    </div>
    <dl class="stats">
      <div><dt>Machines available</dt><dd><%= stats.machines_available || 0 %></dd></div>
      <div><dt>Machines for rent</dt><dd><%= stats.machines_for_rent || 0 %></dd></div>
      <div><dt>Projects delivered</dt><dd><%= stats.projects_delivered || 0 %></dd></div>
      <div><dt>Items sold</dt><dd><%= stats.sold || 0 %></dd></div>
    </dl>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Machinery for sale</h2>
      <a href="/machinery">See all machinery for sale &rarr;</a>
    </div>
    <% if (machinery.length) { %>
      <div class="grid"><% for (const item of machinery) { %><%- include('../partials/card', { item }) %><% } %></div>
    <% } else { %>
      <p class="empty">New stock is coming soon. <a href="/contact">Tell us what you're looking for</a> and we'll find it for you.</p>
    <% } %>
  </div>
</section>

<% if (rentals.length) { %>
<section class="section section-tight-top">
  <div class="container">
    <div class="section-head">
      <h2>Machinery for rent</h2>
      <a href="/rentals">See all rentals &rarr;</a>
    </div>
    <p class="muted">Daily, weekly and monthly hire. Ask us about long-term rates.</p>
    <div class="grid"><% for (const item of rentals) { %><%- include('../partials/card', { item }) %><% } %></div>
  </div>
</section>
<% } %>

<% if (properties.length) { %>
<section class="section section-tight-top">
  <div class="container">
    <div class="section-head">
      <h2>Real estate</h2>
      <a href="/real-estate">See all properties &rarr;</a>
    </div>
    <p class="muted">Properties and land for sale and for rent.</p>
    <div class="grid"><% for (const item of properties) { %><%- include('../partials/card', { item }) %><% } %></div>
  </div>
</section>
<% } %>

<section class="section section-alt">
  <div class="container split">
    <div>
      <h2>About <%= company.company_name %></h2>
      <% for (const p of h.paragraphs(company.about).slice(0, 2)) { %><p><%= p %></p><% } %>
      <% if (company.ceo_name) { %><p class="ceo-line">Led by <strong><%= company.ceo_name %></strong>, Chief Executive Officer</p><% } %>
      <a class="btn btn-ghost" href="/about">More about us</a>
    </div>
    <% const services = h.lines(company.services); if (services.length) { %>
    <div>
      <h3>What we do</h3>
      <ul class="checklist"><% for (const s of services) { %><li><%= s %></li><% } %></ul>
    </div>
    <% } %>
  </div>
</section>

<% if (projects.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Projects</h2>
      <a href="/projects">See all projects &rarr;</a>
    </div>
    <div class="grid"><% for (const item of projects) { %><%- include('../partials/card', { item }) %><% } %></div>
  </div>
</section>
<% } %>

<section class="cta">
  <div class="container cta-inner">
    <div>
      <h2>Looking for something specific?</h2>
      <p>Tell us what you need and our team will get back to you.</p>
    </div>
    <a class="btn btn-primary" href="/contact">Get in touch</a>
  </div>
</section>
<%- include('../partials/footer') %>
