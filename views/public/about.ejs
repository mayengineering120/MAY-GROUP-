<%- include('../partials/header') %>
<section class="page-head"><div class="container"><h1>About <%= company.company_name %></h1><p class="lead"><%= company.tagline %></p></div></section>
<section class="section">
  <div class="container split">
    <div class="prose">
      <% for (const p of h.paragraphs(company.about)) { %><p><%= p %></p><% } %>
    </div>
    <aside class="panel">
      <img class="about-logo" src="/static/img/logo-full.png" alt="<%= company.company_name %> logo" width="218" height="180">
      <% const services = h.lines(company.services); if (services.length) { %>
        <h2 class="h3">Our services</h2>
        <ul class="checklist"><% for (const s of services) { %><li><%= s %></li><% } %></ul>
      <% } %>
      <h2 class="h3">Company details</h2>
      <dl class="details">
        <% if (company.ceo_name) { %><dt>CEO</dt><dd><%= company.ceo_name %></dd><% } %>
        <% if (company.address) { %><dt>Address</dt><dd><%= company.address %></dd><% } %>
        <% if (h.phones(company.phone).length) { %><dt>Phone</dt><dd><% for (const ph of h.phones(company.phone)) { %><a href="<%= h.telHref(ph) %>"><%= ph %></a><br><% } %></dd><% } %>
        <% if (company.email) { %><dt>Email</dt><dd><a href="mailto:<%= company.email %>"><%= company.email %></a></dd><% } %>
        <% if (company.hours) { %><dt>Opening hours</dt><dd><% for (const l of h.lines(company.hours)) { %><%= l %><br><% } %></dd><% } %>
        <% if (company.registration) { %><dt>Registration</dt><dd><%= company.registration %></dd><% } %>
      </dl>
      <a class="btn btn-primary" href="/contact">Contact us</a>
    </aside>
  </div>
</section>
<%- include('../partials/footer') %>
