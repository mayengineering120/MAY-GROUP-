</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand"><%= company.company_name %><% if (company.subtitle) { %> <span class="footer-sub"><%= company.subtitle %></span><% } %></p>
      <p class="muted"><%= company.tagline %></p>
      <% if (company.registration) { %><p class="small muted"><%= company.registration %></p><% } %>
    </div>
    <div>
      <p class="footer-heading">Explore</p>
      <ul class="plain">
        <li><a href="/machinery">Machinery for sale</a></li>
        <li><a href="/rentals">Machinery for rent</a></li>
        <li><a href="/machinery?status=sold">Recently sold</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/about">About us</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-heading">Contact</p>
      <ul class="plain">
        <% for (const ph of h.phones(company.phone)) { %><li><a href="<%= h.telHref(ph) %>"><%= ph %></a></li><% } %>
        <% if (company.whatsapp) { %><li><a href="<%= h.whatsappHref(company.whatsapp) %>" target="_blank" rel="noopener">WhatsApp <%= company.whatsapp %></a></li><% } %>
        <% if (company.email) { %><li><a href="mailto:<%= company.email %>"><%= company.email %></a></li><% } %>
        <% if (company.address) { %><li class="muted"><%= company.address %></li><% } %>
        <% for (const l of h.lines(company.hours)) { %><li class="muted"><%= l %></li><% } %>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom small muted">
    <span>&copy; <%= new Date().getFullYear() %> <%= company.company_name %>. All rights reserved.</span>
    <a href="/staff">Staff login</a>
  </div>
</footer>
<% if (company.whatsapp) { %>
  <a class="wa-float" href="<%= h.whatsappHref(company.whatsapp, (typeof waText !== 'undefined' && waText) || `Hello ${company.company_name}, I have a question.`) %>" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <%- include('whatsapp-icon') %><span class="wa-float-label">Chat on WhatsApp</span>
  </a>
<% } %>
</body>
</html>
