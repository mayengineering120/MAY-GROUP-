<%- include('head') %>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <img class="brand-logo" src="/static/img/logo-mark.png" alt="" width="63" height="48">
      <span class="brand-text"><span class="brand-name"><%= company.company_name %></span><% if (company.subtitle) { %><span class="brand-sub"><%= company.subtitle %></span><% } %></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <% const links = [['/', 'Home'], ['/machinery', 'Machinery'], ['/projects', 'Projects'], ['/about', 'About'], ['/contact', 'Contact']]; %>
      <% for (const [href, label] of links) { const active = href === '/' ? path === '/' : path.startsWith(href); %>
        <a href="<%= href %>"<%- active ? ' aria-current="page"' : '' %>><%= label %></a>
      <% } %>
      <% if (user) { %>
        <a class="nav-staff" href="/staff">Staff portal</a>
      <% } %>
    </nav>
  </div>
</header>
<main id="main">
<%- include('flash') %>
