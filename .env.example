# Copy to your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Set to "true" when running behind a reverse proxy / load balancer that terminates HTTPS
TRUST_PROXY=true
# Optional: where the database and uploaded photos are stored (use a persistent disk)
# DATA_DIR=/var/data/may-group
# UPLOAD_DIR=/var/data/may-group/uploads
