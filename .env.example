# Copy to your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me  (optional: generated automatically and kept in DATA_DIR if empty)
# Set to "true" when running behind a reverse proxy / load balancer that terminates HTTPS
TRUST_PROXY=true
# Optional: where the database and uploaded photos are stored (use a persistent disk)
# DATA_DIR=/var/data/may-group
# UPLOAD_DIR=/var/data/may-group/uploads

# --- Enquiry emails (Gmail) ---
# Every website enquiry is emailed to the address(es) set in Staff portal → Company details.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=musbahalyaqootengineering@gmail.com
# A Google "App password" (16 characters), NOT the normal Gmail password. See README.
SMTP_PASS=
# Public address of the website, used for links inside the emails
SITE_URL=https://www.your-domain.com
